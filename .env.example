# Copy to .env for the one-time token script. Never commit .env.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Filled in after running `npm run token`, then pasted into Vercel's environment variables.
SPOTIFY_REFRESH_TOKEN=

# Optional: an Upstash Redis / Vercel KV database. When set, the last good
# result survives cold starts, so visitors still see a receipt if Spotify is down.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
